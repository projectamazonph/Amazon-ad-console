generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  campaigns     Campaign[]
  simulations   Simulation[]
}

model Campaign {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId    String    // Original campaign ID from the engine
  type          String    // SP, SB, SD
  name          String
  portfolio     String?
  status        String    @default("Enabled")
  dailyBudget   Float     @default(25)
  defaultBid    Float     @default(0.75)
  startDate     String?
  endDate       String?
  targetingMode String?
  adFormat      String?
  campaignGoal  String?
  bidStrategy   String?
  placements   String?   // JSON string
  products     String?   // JSON array
  creative     String?   // JSON object
  metrics      String?   // JSON object
  adGroups     String?   // JSON array
  targets      String?   // JSON array
  searchTerms  String?   // JSON array
  negatives    String?   // JSON array
  budgetRules  String?   // JSON array
  history      String?   // JSON array
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  @@unique([userId, campaignId])
}

model Simulation {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  days        Int       @default(7)
  results     String?   // JSON - simulated campaign states
  createdAt   DateTime  @default(now())
}
